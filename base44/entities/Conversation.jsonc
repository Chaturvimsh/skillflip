{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "user_a_id": {
      "type": "string"
    },
    "user_a_name": {
      "type": "string"
    },
    "user_a_username": {
      "type": "string"
    },
    "user_a_avatar": {
      "type": "string"
    },
    "user_b_id": {
      "type": "string"
    },
    "user_b_name": {
      "type": "string"
    },
    "user_b_username": {
      "type": "string"
    },
    "user_b_avatar": {
      "type": "string"
    },
    "context_title": {
      "type": "string"
    },
    "last_message": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string"
    }
  },
  "required": [
    "participant_ids"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.participant_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.participant_ids": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "update": {
      "$or": [
        {
          "data.participant_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
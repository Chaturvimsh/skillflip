{
  "name": "Proposal",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "creator_id": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "delivery_days": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ],
      "default": "pending"
    },
    "order_id": {
      "type": "string"
    }
  },
  "required": [
    "conversation_id",
    "request_id",
    "buyer_id",
    "creator_id",
    "price",
    "delivery_days",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.creator_id": "{{user.id}}"
    },
    "update": {
      "data.buyer_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
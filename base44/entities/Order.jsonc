{
  "name": "Order",
  "type": "object",
  "properties": {
    "service_id": {
      "type": "string"
    },
    "service_title": {
      "type": "string"
    },
    "service_image": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "buyer_username": {
      "type": "string"
    },
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "seller_username": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "due_date": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "in_progress",
        "delivered",
        "completed",
        "declined"
      ],
      "default": "requested"
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file_uri": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string"
          },
          "uploaded_by": {
            "type": "string"
          }
        }
      }
    },
    "delivery_message": {
      "type": "string"
    },
    "delivered_at": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    },
    "revision_note": {
      "type": "string"
    },
    "revision_requested_at": {
      "type": "string"
    }
  },
  "required": [
    "service_title",
    "price",
    "buyer_id",
    "seller_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.buyer_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
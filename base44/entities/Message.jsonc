{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "default": ""
    },
    "attachment": {
      "type": "object",
      "properties": {
        "file_uri": {
          "type": "string"
        },
        "file_name": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "image",
            "pdf"
          ]
        },
        "size": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "conversation_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.sender_id": "{{user.id}}"
    },
    "update": {
      "data.sender_id": "{{user.id}}"
    },
    "delete": {
      "data.sender_id": "{{user.id}}"
    }
  }
}